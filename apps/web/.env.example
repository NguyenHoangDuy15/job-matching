# Chép thành .env.local (KHÔNG commit). Lấy giá trị ở Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Khóa publishable (sb_publishable_...) hoặc anon key. Không dùng service_role / secret key ở web.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
