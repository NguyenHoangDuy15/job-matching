# Chép thành .env rồi đổi giá trị thật trên máy mình. KHÔNG commit .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jobs
DB_PORT=5432

# Dùng khi chạy công cụ từ máy host (alembic, script); trong compose api tự dùng host "db".
DATABASE_URL=postgresql+psycopg://app:change_me@localhost:5432/jobs

EMBED_MODEL=BAAI/bge-m3
LLM_API_KEY=
