# Chép thành .env.local (KHÔNG commit). Lấy giá trị ở Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Khóa publishable (sb_publishable_...) hoặc anon key. Không dùng service_role / secret key ở web.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API đọc CV POST /cv/parse (S3-D05, docs/deploy/cv-api.md), ví dụ https://jobmatch-cv-api.onrender.com
# Để trống thì trang tải CV chỉ lưu CV, bỏ qua bước phân tích kỹ năng.
NEXT_PUBLIC_CV_API_URL=
