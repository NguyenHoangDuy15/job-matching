# Bí mật – không bao giờ commit
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# Dữ liệu và CV – không lên git
data/*
!data/README.md
# Thư mục lưu file của compose: giữ thư mục (.gitkeep), bỏ nội dung
!data/storage/
data/storage/*
!data/storage/.gitkeep
*.pdf
*.docx
*.doc
*.zip
# Model đã train: giữ thư mục (.gitkeep) để Dockerfile COPY được, bỏ nội dung
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.benchmarks/

# dbt / Airflow
dbt/target/
dbt/logs/
logs/

# IDE / OS
.idea/
.vscode/
.DS_Store
